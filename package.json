{
  "$schema": "https://json.schemastore.org/package",
  "author": "Romain Racamier-Lafon <romain.racamier@gmail.com>",
  "bin": {
    "repo-check": "dist/server/bin.js"
  },
  "bugs": "https://github.com/Shuunen/repo-checker/issues",
  "dependencies": {
    "@hono/node-server": "~2.1.4",
    "es-toolkit": "~1.52.0",
    "hono": "~4.13.13",
    "jsonc-parser": "~3.3.1"
  },
  "description": "Repo maintenance made easy",
  "devDependencies": {
    "@types/node": "~26.6.3",
    "@vitest/coverage-v8": "~5.0.2",
    "dependency-cruiser": "~18.4.0",
    "knip": "~6.38.0",
    "oxfmt": "~0.72.0",
    "oxlint": "~1.86.0",
    "tsdown": "~0.23.1",
    "typescript": "~6.0.3",
    "vitest": "~5.0.2"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/Shuunen/repo-checker",
  "keywords": [
    "cli",
    "repository",
    "check",
    "checker"
  ],
  "license": "GPL-3.0",
  "name": "repo-check",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shuunen/repo-checker.git"
  },
  "scripts": {
    "build": "tsdown && echo build success",
    "check": "bun install && echo install success && bun run build && node dist/server/bin.js --help > /dev/null && echo bin success && bun lint && bun run test && echo check success",
    "lint": "bun lint:format && bun lint:knip && bun lint:tsc && bun lint:oxlint && bun lint:dep && echo lint success",
    "lint:dep": "depcruise src --config && echo lint:dep success",
    "lint:format": "oxfmt src && echo lint:format success",
    "lint:knip": "knip",
    "lint:oxlint": "oxlint src --deny-warnings --fix --fix-suggestions --fix-dangerously && echo lint:oxlint success",
    "lint:tsc": "tsc --noEmit && echo lint:tsc success",
    "postversion": "git push && git push --tags && bun run build && npm publish",
    "preversion": "bun check",
    "scan": "bun src/server/bin.ts",
    "test": "vitest --coverage --run && echo test success",
    "test:update": "vitest --run --update && echo test update success",
    "test:watch": "vitest --coverage",
    "ui": "bun src/server/bin.ts ui"
  },
  "type": "module",
  "version": "1.46.0"
}
