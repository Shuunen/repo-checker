{
  "$schema": "https://json.schemastore.org/package",
  "author": "Romain Racamier-Lafon <romain.racamier@gmail.com>",
  "bin": {
    "repo-check": "dist/server/bin.js"
  },
  "bugs": "https://github.com/Shuunen/repo-checker/issues",
  "dependencies": {
    "@hono/node-server": "~2.1.6",
    "cac": "~7.1.0",
    "es-toolkit": "~1.53.1",
    "hono": "~4.13.16",
    "jsonc-parser": "~3.3.1",
    "lucide-react": "^1.68.0",
    "magicast": "~0.5.5",
    "react-markdown": "^10.1.0",
    "shuutils": "~12.0.0"
  },
  "description": "Repo maintenance made easy",
  "devDependencies": {
    "@heroui/react": "~3.2.7",
    "@heroui/styles": "~3.2.7",
    "@tailwindcss/vite": "~4.3.4",
    "@tanstack/react-query": "~5.105.3",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.2.1",
    "@vitest/coverage-v8": "~5.1.0",
    "diff": "~9.0.0",
    "happy-dom": "~21.0.4",
    "knip": "~6.44.1",
    "oxfmt": "~0.76.0",
    "oxlint": "~1.91.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "tailwindcss": "~4.3.4",
    "tsdown": "~0.23.5",
    "typescript": "~7.0.2",
    "vite": "~8.3.5",
    "vitest": "~5.1.0",
    "wouter": "~3.13.0"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "homepage": "https://github.com/Shuunen/repo-checker",
  "keywords": [
    "cli",
    "repository",
    "check",
    "checker"
  ],
  "license": "GPL-3.0",
  "name": "repo-check",
  "packageManager": "pnpm@12.16.1",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shuunen/repo-checker.git"
  },
  "scripts": {
    "build": "tsdown && vite build && echo build success",
    "demo": "node demo/start.mjs",
    "dev": "vite",
    "dev:ui": "node src/server/bin.ts ui --watch --target=..",
    "check": "pnpm install && echo install success && pnpm run build && pnpm lint && pnpm run test && echo check success",
    "lint": "pnpm lint:format && pnpm lint:cli && pnpm lint:knip && pnpm lint:tsc && pnpm lint:oxlint && echo lint success",
    "lint:cli": "node dist/server/bin.js --help && echo lint:cli success",
    "lint:format": "oxfmt src && echo lint:format success",
    "lint:knip": "knip",
    "lint:oxlint": "oxlint src --deny-warnings --fix --fix-suggestions --fix-dangerously && echo lint:oxlint success",
    "lint:tsc": "tsc --noEmit && echo lint:tsc success",
    "postversion": "git push && git push --tags && pnpm run build && npm publish",
    "preversion": "pnpm check",
    "scan": "node src/server/bin.ts",
    "test": "vitest --coverage --run && echo test success",
    "test:update": "vitest --run --update && echo test update success",
    "test:watch": "vitest --coverage",
    "ui": "node src/server/bin.ts ui"
  },
  "type": "module",
  "version": "2.0.0-rc.1"
}
