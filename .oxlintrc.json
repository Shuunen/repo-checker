{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "nursery": "warn",
    "pedantic": "warn",
    "perf": "warn",
    "restriction": "warn",
    "style": "warn",
    "suspicious": "warn"
  },
  "env": {
    "node": true
  },
  "globals": {
    "__filename": "readonly",
    "process": "readonly"
  },
  "ignorePatterns": ["demo/**"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "overrides": [
    {
      "files": ["src/server/engine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/rules/**"],
                "message": "The engine runs rules and knows no rule, rules import from the engine, never the reverse (see docs/architecture.md)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/web/public/sw.js"],
      "rules": {
        "import/unambiguous": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/prefer-promise-reject-errors": "off"
      }
    },
    {
      "env": {
        "browser": true
      },
      "files": ["src/web/**"],
      "rules": {
        "jsdoc/require-param": [
          "error",
          {
            "checkDestructured": false
          }
        ]
      }
    },
    {
      "env": {
        "vitest": true
      },
      "files": ["src/server/test/rule-tester.ts", "src/server/test/discard-fixtures.ts", "src/server/test/app-fixtures.ts", "src/server/test/cli-fixtures.ts", "src/server/test/fake-command-fixtures.ts", "src/server/test/git-fixtures.ts", "src/web/test/fixtures.ts", "src/web/test/render-app.tsx"]
    },
    {
      "env": {
        "vitest": true
      },
      "files": ["*.test.ts", "*.test.tsx"],
      "plugins": ["vitest"],
      "rules": {
        "eslint/max-lines-per-function": "off",
        "max-nested-callbacks": "off",
        "no-magic-numbers": "off",
        "typescript/no-base-to-string": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/prefer-promise-reject-errors": "off",
        "vitest/consistent-test-it": [
          "error",
          {
            "fn": "it",
            "withinDescribe": "it"
          }
        ],
        "vitest/prefer-called-times": "off",
        "vitest/prefer-importing-vitest-globals": "off",
        "vitest/prefer-lowercase-title": "off",
        "vitest/prefer-to-be-falsy": "off",
        "vitest/prefer-to-be-truthy": "off",
        "vitest/require-hook": [
          "warn",
          {
            "allowedFunctionCalls": ["testRule", "testProjectRule"]
          }
        ],
        "vitest/require-test-timeout": "off",
        "vitest/valid-title": "off"
      }
    },
    {
      "files": ["*.config.{js,mjs,mts,ts}"],
      "rules": {
        "no-default-export": "off"
      }
    }
  ],
  "plugins": ["import", "jsdoc", "oxc", "promise", "react", "typescript", "unicorn"],
  "rules": {
    "@typescript-eslint/array-type": "off",
    "@typescript-eslint/consistent-indexed-object-style": "off",
    "@typescript-eslint/explicit-function-return-type": "off",
    "consistent-type-specifier-style": "off",
    "curly": ["error", "multi"],
    "eslint/capitalized-comments": "off",
    "eslint/logical-assignment-operators": "off",
    "eslint/max-depth": ["error", 2],
    "eslint/max-lines-per-function": ["error", 30],
    "eslint/max-statements": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-undefined": "off",
    "eslint/one-var": "off",
    "eslint/yoda": "off",
    "func-style": [
      "error",
      "declaration",
      {
        "allowArrowFunctions": true
      }
    ],
    "import/exports-last": "off",
    "import/group-exports": "off",
    "import/no-named-export": "off",
    "import/no-nodejs-modules": "off",
    "import/no-relative-parent-imports": "off",
    "import/prefer-default-export": "off",
    "jsdoc/require-param-type": "off",
    "jsdoc/require-returns-type": "off",
    "no-async-await": "off",
    "no-continue": "off",
    "no-default-export": "error",
    "no-magic-numbers": [
      "error",
      {
        "ignore": [-1, 0, 1],
        "ignoreClassFieldInitialValues": true,
        "ignoreDefaultValues": true
      }
    ],
    "no-rest-spread-properties": "off",
    "no-ternary": "off",
    "no-void": "off",
    "oxc/no-optional-chaining": "off",
    "react/forbid-component-props": "off",
    "react/jsx-filename-extension": [
      "error",
      {
        "extensions": [".tsx"]
      }
    ],
    "react/jsx-max-depth": [
      "error",
      {
        "max": 5
      }
    ],
    "react/jsx-no-literals": "off",
    "react/react-in-jsx-scope": "off",
    "sort-imports": "off",
    "typescript/explicit-module-boundary-types": "off",
    "typescript/no-confusing-void-expression": "off",
    "typescript/no-unnecessary-condition": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/non-nullable-type-assertion-style": "off",
    "typescript/prefer-nullish-coalescing": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/promise-function-async": "off",
    "typescript/strict-boolean-expressions": "off",
    "typescript/strict-void-return": "off",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "unicorn/no-useless-undefined": "off",
    "unicorn/prefer-import-meta-properties": "off",
    "unicorn/prefer-top-level-await": "off"
  }
}
