{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "ignorePatterns": ["src/mocks/**", "**/__snapshots__/**"],
  "jsxSingleQuote": false,
  "objectWrap": "preserve",
  "printWidth": 300,
  "quoteProps": "as-needed",
  "semi": false,
  "singleAttributePerLine": false,
  "singleQuote": true,
  "sortImports": {
    "ignoreCase": true,
    "newlinesBetween": false
  },
  "sortPackageJson": false,
  "sortTailwindcss": {
    "functions": ["clsx", "cn", "cva", "tw"]
  },
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false
}
